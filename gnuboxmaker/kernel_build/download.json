[
    {
        "type": "gitclone",
        "name": "linux-embedded-patchs",
        "export": false,

        "git_url": "https://github.com/igorkll/linux-embedded-patchs",
        "git_checkout": "5.4"
    },
    {
        "type": "gitclone",
        "name": "custom-debian-initramfs-init",
        "export": false,

        "git_url": "https://github.com/igorkll/custom-debian-initramfs-init",
        "git_checkout": "1.5.2"
    },

    // extract "custom-debian-initramfs-init"
    {
        "type": "from-directory",
        "name": "custom_init.sh",
        "export": false,
    
        "source": "custom-debian-initramfs-init",
        "path": "/custom_init.sh"
    },
    {
        "type": "from-directory",
        "name": "custom_init_hook.sh",
        "export": false,

        "source": "custom-debian-initramfs-init",
        "path": "/custom_init_hook.sh"
    }
]
