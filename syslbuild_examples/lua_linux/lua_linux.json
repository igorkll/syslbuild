{
    "architectures": [
        "amd64"
    ],

    "builditems": [
        {
            "type": "include",
            "file": "download.json"
        },
        {
            "type": "include",
            "file": "kernel.json"
        },
        {
            "type": "include",
            "file": "initramfs.json"
        },
        
        // --------------------------------- bootable image
        {
            "architectures": ["amd64"],
            
            "type": "filesystem",
            "name": "bios boot.img",
            "export": false,

            "size": "1M"
        },
        {
            "architectures": ["amd64"],

            "type": "filesystem",
            "name": "efi boot.img",
            "export": false,

            "fs_arg": "-F32",
            "fs_type": "fat",
            "size": "64M",
            "label": "EFI"
        },
        {
            "architectures": ["amd64"],
            
            "type": "full-disk-image",
            "name": "lua linux (EFI+BIOS).img",
            "export": true,

            "size": "auto + (10 * 1024 * 1024)",

            "partitionTable": "gpt",
            "partitions": [
                ["bios boot.img", "bios"],
                ["efi boot.img", "efi"],
                ["rootfs.img", "linux"]
            ],

            "bootloader": {
                "type": "grub",
                "config": "grub_fastboot.cfg",
                "esp": 1,
                "boot": 2,
                "efiAndBios": true,
                "modules": [
                    "normal",
                    "part_msdos",
                    "part_gpt",
                    "ext2",
                    "configfile"
                ]
            }
        }
    ]
}
