{
    "architectures": [
        "amd64",
        "i386"
    ],

    "builditems": [
        // ----------------------------------- debian rootfs
        {
            "type": "debian",
            "name": "debian",
            "export": false,

            "kernel": "default",
            "include": [
                "cowsay",
                "plymount"
            ],

            "variant": "minbase", //we use a snapshot for a deterministic build
            "suite": "bookworm",
            "url": "http://snapshot.debian.org/archive/debian/20250809T133719Z"
        },
        {
            "type": "filesystem",
            "name": "rootfs.img",
            "export": false,

            "source": "debian",

            "fs_type": "ext4",
            "size": "(auto * 1.2) + (100 * 1024 * 1024)",
            "minsize": "64MB",
            "label": "rootfs"
        },

        // ----------------------------------- bootable image
        {
            "type": "filesystem",
            "name": "bios boot.img",
            "export": false,

            "size": "1M"
        },
        {
            "type": "filesystem",
            "name": "efi boot.img",
            "export": false,

            "fs_arg": "-F32",
            "fs_type": "fat",
            "size": "64M",
            "label": "EFI"
        },
        {
            "type": "full-disk-image",
            "name": "debian (EFI+BIOS).img",
            "export": true,

            "size": "auto + (10 * 1024 * 1024)",

            "partitionTable": "gpt",
            "partitions": [
                ["bios boot.img", "bios"],
                ["efi boot.img", "efi"],
                ["example-distro rootfs.img", "linux"]
            ],

            "bootloader": {
                "type": "grub",
                "config": "grub_fastboot.cfg",
                "esp": 1,
                "boot": 2,
                "efiAndBios": true,
                "modules": [
                    "normal",
                    "part_msdos",
                    "part_gpt",
                    "ext2",
                    "configfile"
                ]
            }
        }
    ]
}
