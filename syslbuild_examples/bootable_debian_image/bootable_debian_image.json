{
    "architectures": [
        "amd64",
        "i386"
    ],

    "builditems": [
        // ----------------------------------- debian rootfs
        {
            "type": "debian",
            "name": "debian",
            "export": false,

            "kernel": "default",
            "include": [
                "cowsay", //example package

                "initramfs-tools",
                "systemd",
                "systemd-sysv",
                "systemd-resolved",
                "dbus",
                "dbus-user-session",

                "bash",
                "sudo"
            ],

            "variant": "minbase", //we use a snapshot for a deterministic build
            "suite": "bookworm",
            "url": "http://snapshot.debian.org/archive/debian/20250809T133719Z"
        },

        {
            "type": "directory",
            "name": "debian_with_overlay",
            "export": false,

            "items": [
                // in fact, you could specify here: ["debian", "/", null, false, null, true, false] since DONT_CHANGE_RIGHTS_ON_EXISTS_DIRS does not make sense when there are no files yet
                ["debian", "/", null, false, null, true, true],
                
                //in fact, you can specify here: ["overlay", "/", [[0, 0, "0644"], [0, 0, "0755"]], false, null, false, true] because CHANGE_RIGHTS_ON_TARGET_ROOT will not transfer rights anyway when the directory already exists and the DONT_CHANGE_RIGHTS_ON_EXISTS_DIRS flag is set
                ["overlay", "/", [[0, 0, "0644"], [0, 0, "0755"]], false, null, true, true]
            ]
        },
        
        {
            "type": "smart-chroot",
            "name": "debian_with_chroot",
            "export": false,

            "source": "debian_with_overlay",
            "scripts": [
                "chroot.sh"
            ]
        },

        {
            "type": "filesystem",
            "name": "rootfs.img",
            "export": false,

            "source": "debian_with_chroot",

            "fs_type": "ext4",
            "size": "(auto * 1.2) + (100 * 1024 * 1024)",
            "minsize": "64MB",
            "label": "rootfs"
        },

        // ----------------------------------- bootable image
        {
            "independent_architecture": true,
            "type": "download",
            "name": "linux-bootloaders.tar.gz",
            "url": "https://github.com/igorkll/linux-bootloaders/releases/download/1.2/linux-bootloaders.tar.gz"
        },
        {
            "independent_architecture": true,
            "type": "unpack-tar-auto",
            "name": "linux-bootloaders",
            "archive": "linux-bootloaders.tar.gz"
        },

        {
            "type": "filesystem",
            "name": "bios boot.img",
            "export": false,

            "size": "1M"
        },
        {
            "type": "filesystem",
            "name": "efi boot.img",
            "export": false,

            "fs_arg": "-F32",
            "fs_type": "fat",
            "size": "64M",
            "label": "EFI"
        },
        {
            "type": "full-disk-image",
            "name": "debian (EFI+BIOS).img",
            "export": true,

            "size": "auto + (10 * 1024 * 1024)",

            "partitionTable": "gpt",
            "partitions": [
                ["bios boot.img", "bios"],
                ["efi boot.img", "efi"],
                ["rootfs.img", "linux"]
            ],

            "bootloader": {
                "type": "grub",
                "config": "grub_fastboot.cfg",
                "esp": 1,
                "boot": 2,
                "efiAndBios": true,
                "modules": [
                    "normal",
                    "part_msdos",
                    "part_gpt",
                    "ext2",
                    "configfile"
                ],
                "build": "linux-bootloaders/grub/build/no-welcome-2.14"
            }
        }
    ]
}
