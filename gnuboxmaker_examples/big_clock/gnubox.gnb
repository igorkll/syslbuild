{
  "gnubox_version": [
    1,
    6,
    5
  ],
  "distro": "debian",
  "user_packages": [
    "nodejs",
    "npm",
    "libnspr4",
    "libnss3",
    "libxss1",
    "libatk1.0-0",
    "libatk-bridge2.0-0",
    "libxcomposite1",
    "libxcursor1",
    "libxdamage1",
    "libxrandr2",
    "libxkbcommon0",
    "libwayland-client0",
    "libwayland-egl1",
    "libgbm1",
    "libgtk-3-0",
    "nano"
  ],
  "exclude_packages": [],
  "debian_variant": "minbase",
  "debian_suite": "<default>",
  "debian_snapshot": "<default>",
  "screen_idle_time": 0,
  "HandlePowerKey": "poweroff",
  "HandleRebootKey": "reboot",
  "HandleSuspendKey": "ignore",
  "HandleHibernateKey": "ignore",
  "HandleLidSwitch": "ignore",
  "boot_quiet": true,
  "boot_splash": true,
  "boot_sound": "logo",
  "dont_show_splash_on_poweroff": true,
  "dont_use_splash_on_efi": false,
  "uartlogs": true,
  "uartlogs_speed": 115200,
  "uartlogs_rootshell": true,
  "exclude_tty1_from_consoles": false,
  "exclude_tty1_from_consoles_in_quiet": true,
  "make_tty1_primary_console": false,
  "splash_bg": "0, 0, 0",
  "splash_updating_bg": "0, 0, 0",
  "splash_mode": "contain",
  "splash_scale": 0.7,
  "use_separate_splash_for_update": true,
  "root_expand": true,
  "root_readonly": false,
  "allow_updatescript": false,
  "separate_data_partition": false,
  "separate_data_partition_home_link": true,
  "separate_data_partition_var_link": false,
  "separate_data_partition_etc_link": false,
  "var_is_temp": true,
  "minsize_boot_partition": "64MB",
  "minsize_efi_partition": "64MB",
  "minsize_root_partition": "64MB",
  "minsize_data_partition": "64MB",
  "size_boot_partition": "(auto * 1.2) + (100 * 1024 * 1024)",
  "size_efi_partition": "256MB",
  "size_root_partition": "(auto * 1.2) + (100 * 1024 * 1024)",
  "weston_shell": "kiosk",
  "session_user": "user",
  "session_mode": "wayland",
  "minlogotime": 10,
  "cmdline": "",
  "exclude_cmdline": [],
  "sudo_privileges": true,
  "integrate_liamounts": true,
  "integrate_super_kiosk_browser": false,
  "integrate_xwayland": true,
  "integrate_firmwares": true,
  "integrate_bluetooth": true,
  "integrate_network": true,
  "integrate_network_resolved": true,
  "integrate_network_timesync": true,
  "integrate_network_wifi": true,
  "integrate_audio": true,
  "export_x86_64": false,
  "export_x86": false,
  "export_arm64": true,
  "export_arm": false,
  "export_img_bios_mbr": false,
  "export_img_bios_gpt": false,
  "export_img_uefi_gpt": false,
  "export_img_bios_and_uefi_gpt": true,
  "export_img_opi_zero3": false,
  "export_img_rpi_32": false,
  "export_img_rpi_64": true
}