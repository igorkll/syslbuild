{
  "gnubox_version": [
    1,
    12,
    1
  ],
  "distro": "debian",
  "user_packages": [
    "nodejs",
    "npm",
    "pipewire",
    "pipewire-pulse",
    "wireplumber",
    "libspa-0.2-modules",
    "alsa-utils",
    "libpulse0",
    "libnspr4",
    "libnss3",
    "libxss1",
    "libatk1.0-0",
    "libatk-bridge2.0-0",
    "libxcomposite1",
    "libxcursor1",
    "libxdamage1",
    "libxrandr2",
    "libxkbcommon0",
    "libwayland-client0",
    "libwayland-egl1",
    "libgbm1",
    "libgtk-3-0",
    "nano"
  ],
  "temp_packages": [],
  "exclude_packages": [],
  "delete_packages": [],
  "debian_variant": "minbase",
  "debian_suite": "<default>",
  "debian_snapshot": "<default>",
  "screen_idle_time": 0,
  "HandlePowerKey": "poweroff",
  "HandleRebootKey": "reboot",
  "HandleSuspendKey": "ignore",
  "HandleHibernateKey": "ignore",
  "HandleLidSwitch": "ignore",
  "boot_quiet": false,
  "boot_splash": true,
  "boot_kernel_logo": false,
  "boot_sound": "none",
  "loglevel_without_quiet": 4,
  "dont_show_splash_on_poweroff": true,
  "dont_use_splash_on_efi": false,
  "enable_echo": false,
  "enable_cursor": false,
  "uartlogs": true,
  "uartlogs_speed": 115200,
  "uartlogs_login": true,
  "uartlogs_rootshell": false,
  "root_login_unlock": true,
  "password_root": "",
  "password_user": "",
  "exclude_tty1_from_consoles": true,
  "exclude_tty1_from_consoles_in_quiet": true,
  "make_tty1_primary_console": false,
  "splash_bg": "0, 0, 0",
  "splash_updating_bg": "0, 0, 0",
  "splash_mode": "contain",
  "splash_scale": 0.7,
  "use_separate_splash_for_update": true,
  "allow_plymouth_change_state_to_update_later": true,
  "timezone": "UTC",
  "rtc_mode": "UTC",
  "root_expand": true,
  "root_readonly": false,
  "allow_updatescript": false,
  "separate_data_partition": false,
  "separate_data_partition_home_link": true,
  "separate_data_partition_var_link": true,
  "separate_data_partition_etc_link": false,
  "separate_data_partition_home_merge_mode": "none",
  "separate_data_partition_var_merge_mode": "none",
  "separate_data_partition_etc_merge_mode": "add",
  "var_is_temp": false,
  "minsize_boot_partition": "64MB",
  "minsize_efi_partition": "64MB",
  "minsize_root_partition": "64MB",
  "minsize_data_partition": "64MB",
  "size_boot_partition": "(auto * 1.2) + (100 * 1024 * 1024)",
  "size_efi_partition": "256MB",
  "size_root_partition": "(auto * 1.2) + (100 * 1024 * 1024)",
  "weston_shell": "kiosk",
  "session_user": "root",
  "session_mode": "wayland",
  "minlogotime": 10,
  "sudo_privileges": false,
  "cmdline_prepand": "",
  "cmdline": "",
  "cmdline_append": "",
  "exclude_cmdline": [],
  "add_clear_commands_if_not_quiet": true,
  "disable_systemd_messages_if_not_quiet": true,
  "always_add_quiet_parameter": true,
  "integrate_liamounts": false,
  "integrate_super_kiosk_browser": false,
  "integrate_xwayland": true,
  "integrate_firmwares": true,
  "integrate_firmwares2": true,
  "integrate_armbian_firmwares_if_need": true,
  "integrate_raspberry_firmwares_if_need": true,
  "integrate_bluetooth": true,
  "integrate_network": true,
  "integrate_network_resolved": true,
  "integrate_network_timesync": true,
  "integrate_network_wifi": true,
  "integrate_audio": true,
  "integrate_advanced_gpu_packages": true,
  "integrate_cpu_microcode_for_x86": true,
  "initramfs_use_list_mode": false,
  "initramfs_add_internal_modules_list": true,
  "initramfs_add_modules": [],
  "wifi_autoconnect_name": "",
  "wifi_autoconnect_password": "",
  "wifi_autoconnect_security": "wpa-psk",
  "plymouth_disable_esc_button": true,
  "plymouth_allow_render_text": false,
  "plymouth_show_boot_status": true,
  "plymouth_show_update_status": true,
  "disable_hardware_vulnerabilities_fixs_boost_old_cpu": false,
  "export_x86_64": false,
  "export_x86": false,
  "export_arm64": true,
  "export_arm": false,
  "export_armel": false,
  "export_img_bios_mbr": false,
  "export_img_bios_gpt": false,
  "export_img_uefi_gpt": false,
  "export_img_bios_and_uefi_gpt": true,
  "export_img_uefi_arm64": false,
  "export_img_opi_zero3": true,
  "export_img_rpi_32_armel": false,
  "export_img_rpi_32": false,
  "export_img_rpi_64": false,
  "export_rootfs_directory": false,
  "export_rootfs_tar_gz": false,
  "export_rootfs_tar_xz": false,
  "export_rootfs_tar": false,
  "platform_opi_zero3_cma": "256M",
  "platform_opi_zero3_hdmi_audio_high_priority": true,
  "rebranding_enabled": true,
  "rebranding_issue": "gnubox \\n \\l\n\n",
  "rebranding_issue_net": "gnubox\n",
  "rebranding_motd": "",
  "rebranding_os_release_name": "Gnubox",
  "rebranding_os_release_id": "gnubox",
  "rebranding_remove_debian_logos": true,
  "rebranding_hostname": "hostname"
}